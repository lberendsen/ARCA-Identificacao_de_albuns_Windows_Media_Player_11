<Window x:Class="ARCA.Identificar.JanelaDiscografia"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ARCA — Organizar pela discografia"
        Width="1300" Height="820" MinWidth="1000" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Canvas}">
    <!-- Organizar pela discografia. O que é texto fixo, cor, margem e tamanho
         se ajusta aqui (ou no designer do VS 2010); o que muda com os dados
         (faixas, status, resumo) é preenchido pelo JanelaDiscografia.xaml.cs. -->
    <DockPanel>

        <!-- ===== Faixa de cima ===== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource CabecalhoColuna}"
                BorderBrush="{StaticResource Borda}" BorderThickness="0,0,0,1" Padding="14,10">
            <StackPanel>
                <TextBlock Text="Organizar pela discografia" FontSize="17" Foreground="{StaticResource Acento}" />
                <TextBlock x:Name="m_lblResumoEntrada" Style="{StaticResource Fraco}" Margin="0,3,0,8"
                           Text="N faixa(s) em N pasta(s). Pelo título de cada faixa, o ano e a duração, o disco de onde ela veio." />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Artista" Style="{StaticResource Fraco}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="m_txtArtista" Width="280" Padding="3" />
                    <Button x:Name="m_btnLer" Content="Ler discografia" IsDefault="True" Padding="14,4" Margin="8,0,0,0" Click="AoLer" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ===== Área de comandos, embaixo ===== -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource BarraFerramentas}"
                BorderBrush="{StaticResource Borda}" BorderThickness="0,1,0,0" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="m_lblStatus" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{StaticResource Texto}" Text="(mensagens de status)" />
                <Button x:Name="m_btnAplicar" Grid.Column="1" Content="Aplicar" Padding="18,6" Margin="12,0,0,0" IsEnabled="False" Click="AoAplicar" />
                <Button x:Name="m_btnFechar" Grid.Column="2" Content="Fechar" IsCancel="True" Padding="18,6" Margin="8,0,0,0" Click="AoFechar" />
            </Grid>
        </Border>

        <!-- ===== Corpo ===== -->
        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- Esquerda: grade e registro -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="110" />
                </Grid.RowDefinitions>
                <TextBlock Text="Faixas — para trocar o disco de uma faixa, dê dois cliques na coluna &quot;→ Disco&quot;"
                           Style="{StaticResource Rotulo}" />

                <DataGrid x:Name="m_grade" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                          CanUserDeleteRows="False" CanUserReorderColumns="False" SelectionMode="Single"
                          HeadersVisibility="Column" GridLinesVisibility="None">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="✓" Width="30"
                                                Binding="{Binding blnAplicar, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <DataGridTextColumn Header="Pasta" Width="0.6*" Binding="{Binding strPasta}" IsReadOnly="True" />
                        <DataGridTextColumn Header="Título atual" Width="1.1*" Binding="{Binding strTituloAtual}" IsReadOnly="True" />
                        <DataGridTextColumn Header="Ano" Width="44" Binding="{Binding strAnoAtual}" IsReadOnly="True" />
                        <DataGridTextColumn Header="Dur." Width="46" Binding="{Binding strDuracao}" IsReadOnly="True" />
                        <DataGridTemplateColumn Header="→ Disco" Width="1.3*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding strDisco}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding lstOpcoes}"
                                              SelectedItem="{Binding objEscolhida, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="→ Nº" Width="40" Binding="{Binding strNumero}" IsReadOnly="True" />
                        <DataGridTextColumn Header="→ Título" Width="1.2*" Binding="{Binding strTituloNovo}" IsReadOnly="True" />
                        <DataGridTextColumn Header="Dif." Width="52" Binding="{Binding strDif}" IsReadOnly="True" />
                        <DataGridTextColumn Header="Confiança" Width="70" Binding="{Binding strConfianca}" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{Binding objCorConfianca}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Resultado" Width="0.8*" Binding="{Binding strResultado}" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBox x:Name="m_txtLog" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" />
            </Grid>

            <!-- Direita: resumo e opções -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Discos propostos" Style="{StaticResource Rotulo}" />
                    <TextBlock x:Name="m_lblResumo" Style="{StaticResource Fraco}" Text="(depois de ler a discografia)" />

                    <TextBlock Text="Ao aplicar" Style="{StaticResource Rotulo}" Margin="0,18,0,6" />
                    <!-- Padrões pedidos pelo Lorenzo (20/11/2026): só confiança alta, e cada disco na sua pasta. -->
                    <CheckBox x:Name="m_chkSoAlta" Content="Marcar só as de confiança alta" IsChecked="True" Margin="0,0,0,6" Click="AoMarcarSoAlta" />
                    <CheckBox x:Name="m_chkCapas" Content="Gravar a capa de cada disco (Discogs)" IsChecked="True" Margin="0,0,0,6" />
                    <CheckBox x:Name="m_chkMover" Content="Mover cada disco para a sua pasta" IsChecked="True" />
                    <TextBlock Style="{StaticResource Fraco}" Margin="20,2,0,0"
                               Text="Ex.: MP3\Roberto Carlos\1966 - Roberto Carlos (1966). A pasta antiga que ficar só com miniaturas sai. Desmarcado, as faixas ficam onde estão, e a capa da pasta (Folder.jpg) só é gravada quando a pasta inteira é de um disco só." />
                    <TextBlock Style="{StaticResource Fraco}" Margin="0,14,0,0"
                               Text="Discos com o mesmo nome do mesmo artista (os vários &quot;Roberto Carlos&quot;) ganham o ano no nome do álbum, senão o WMP junta todos num álbum só." />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
