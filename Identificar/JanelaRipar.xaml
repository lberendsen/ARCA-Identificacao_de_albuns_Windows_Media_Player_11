<Window x:Class="ARCA.Identificar.JanelaRipar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ARCA — copiar o CD (cópia segura)"
        Width="860" Height="660" MinWidth="640" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Canvas}">
    <!-- A cópia segura de um CD, aberta pelo WMP (menu Copiar do CD › "ARCA: copiar este CD").
         Lê o disco pelo SCSI, confere no AccurateRip, relê o que a base não confirmar, corta
         com o offset do leitor corrigido e codifica em WMA Lossless conferido bit a bit.
         As faixas ficam na pasta de entrada (fora do acervo); o Identificar abre em seguida e
         só o "Aplicar às faixas" leva o disco ao acervo. Comportamento em JanelaRipar.xaml.cs;
         o rip em si em Ripador.cs. -->
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource CabecalhoColuna}"
                BorderBrush="{StaticResource Borda}" BorderThickness="0,0,0,1" Padding="14,10">
            <StackPanel>
                <TextBlock x:Name="m_lblTitulo" Text="Copiar o CD — cópia segura" FontSize="17" Foreground="{StaticResource Acento}" />
                <TextBlock x:Name="m_lblLeitor" Style="{StaticResource Fraco}" Margin="0,3,0,0" TextWrapping="Wrap"
                           Text="Leitor E: · lendo pelo SCSI, conferindo no AccurateRip, WMA Lossless idêntico ao disco" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource BarraFerramentas}"
                BorderBrush="{StaticResource Borda}" BorderThickness="0,1,0,0" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="m_lblPasta" Style="{StaticResource Fraco}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Text="(pasta de entrada)" />
                <Button x:Name="m_btnAbrirPasta" Grid.Column="1" Content="Abrir a pasta" Padding="12,6" Margin="12,0,0,0" Click="AoAbrirPasta"
                        ToolTip="Mostra no Windows Explorer a pasta de entrada deste disco (fora do acervo)." />
                <Button x:Name="m_btnIdentificar" Grid.Column="2" Content="Identificar e levar ao acervo…" Padding="14,6" Margin="8,0,0,0"
                        IsEnabled="False" Click="AoIdentificar"
                        ToolTip="Abre o Identificar com as faixas copiadas. Nada vai para o acervo até você clicar em &quot;Aplicar às faixas&quot; lá." />
                <Button x:Name="m_btnFechar" Grid.Column="3" Content="Fechar" IsCancel="True" Padding="18,6" Margin="8,0,0,0" Click="AoFechar" />
            </Grid>
        </Border>

        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>

            <!-- As quatro etapas, com a atual em destaque. -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock x:Name="m_lblEtapa1" Text="1 Leitura" Margin="0,0,18,0" Foreground="{StaticResource TextoFraco}" />
                <TextBlock x:Name="m_lblEtapa2" Text="2 AccurateRip e releitura" Margin="0,0,18,0" Foreground="{StaticResource TextoFraco}" />
                <TextBlock x:Name="m_lblEtapa3" Text="3 WMA Lossless conferido" Margin="0,0,18,0" Foreground="{StaticResource TextoFraco}" />
                <TextBlock x:Name="m_lblEtapa4" Text="4 Identificar" Foreground="{StaticResource TextoFraco}" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                <Grid>
                    <TextBlock x:Name="m_lblFase" FontSize="14" Foreground="{StaticResource Texto}" Text="Preparando…" />
                    <TextBlock x:Name="m_lblDetalhe" HorizontalAlignment="Right" Style="{StaticResource Fraco}" Text="" />
                </Grid>
                <ProgressBar x:Name="m_barra" Height="14" Margin="0,6,0,0" Minimum="0" Maximum="100" />
                <TextBlock x:Name="m_lblVeredito" FontSize="14" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"
                           Foreground="{StaticResource Texto}" Text="(veredito)" />
            </StackPanel>

            <DataGrid x:Name="m_grade" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserReorderColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nº" Width="34" Binding="{Binding strNumero}" />
                    <DataGridTextColumn Header="Faixa" Width="1.3*" Binding="{Binding strTitulo}" />
                    <DataGridTextColumn Header="Duração" Width="62" Binding="{Binding strDuracao}" />
                    <DataGridTextColumn Header="AccurateRip" Width="1*" Binding="{Binding strAccurateRip}" />
                    <DataGridTextColumn Header="Releitura" Width="0.8*" Binding="{Binding strReleitura}" />
                    <DataGridTextColumn Header="WMA" Width="0.7*" Binding="{Binding strWma}" />
                    <DataGridTextColumn Header="Veredito" Width="1*" Binding="{Binding strVeredito}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{Binding objCor}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="3" Text="Registro" Style="{StaticResource Rotulo}" Margin="0,10,0,4" />
            <TextBox x:Name="m_txtLog" Grid.Row="4" IsReadOnly="True" FontFamily="{StaticResource FonteMono}" FontSize="11"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
        </Grid>
    </DockPanel>
</Window>
