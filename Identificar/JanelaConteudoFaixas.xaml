<Window x:Class="ARCA.Identificar.JanelaConteudoFaixas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Música, audiolivro ou fala"
        Width="780" Height="600" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Canvas}">
    <!-- O que cada faixa é: música, audiolivro ou fala (entrevista, humor, aula).
         Grava a classe de mídia que o WMP usa para separar audiolivros da música.
         Comportamento no JanelaConteudoFaixas.xaml.cs. -->
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource CabecalhoColuna}"
                BorderBrush="{StaticResource Borda}" BorderThickness="0,0,0,1" Padding="14,10">
            <StackPanel>
                <TextBlock Text="Música, audiolivro ou fala" FontSize="17" Foreground="{StaticResource Acento}" />
                <TextBlock Style="{StaticResource Fraco}" Margin="0,3,0,0"
                           Text="É por faixa: as entrevistas de um disco são fala dentro de um álbum de música, e continuam no mesmo álbum. Não mexe no gênero nem no resto das tags." />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource BarraFerramentas}"
                BorderBrush="{StaticResource Borda}" BorderThickness="0,1,0,0" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="m_lblStatus" Style="{StaticResource Fraco}" VerticalAlignment="Center" Text="(status)" />
                <Button x:Name="m_btnAplicar" Grid.Column="1" Content="Aplicar" Padding="18,6" Margin="12,0,0,0" Click="AoAplicar" />
                <Button Grid.Column="2" Content="Fechar" IsCancel="True" Padding="18,6" Margin="8,0,0,0" Click="AoFechar" />
            </Grid>
        </Border>

        <DockPanel Margin="14">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Todas as faixas:" Style="{StaticResource Fraco}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button Content="Música" Padding="10,3" Margin="0,0,4,0" Click="AoTudoMusica" />
                <Button Content="Audiolivro" Padding="10,3" Margin="0,0,4,0" Click="AoTudoAudiolivro" />
                <Button Content="Fala" Padding="10,3" Click="AoTudoFala" />
            </StackPanel>
            <DataGrid x:Name="m_grade" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserReorderColumns="False" HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Extended">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Faixa" Width="1.2*" Binding="{Binding strArquivo}" IsReadOnly="True" />
                    <DataGridTextColumn Header="Título" Width="1*" Binding="{Binding strTitulo}" IsReadOnly="True" />
                    <DataGridTextColumn Header="Hoje" Width="80" Binding="{Binding strAntes}" IsReadOnly="True" />
                    <DataGridTemplateColumn Header="Passa a ser" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding lstOpcoes}" SelectedItem="{Binding strDepois, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Resultado" Width="0.8*" Binding="{Binding strResultado}" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </DockPanel>
</Window>
