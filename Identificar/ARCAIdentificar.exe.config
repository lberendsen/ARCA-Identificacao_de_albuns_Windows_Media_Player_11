<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0" />
  </startup>
  <appSettings>
    <!-- O ARCA Central, no notebook, do outro lado do cabo. Unica saida de rede. -->
    <add key="ArcaCentral" value="http://192.168.50.1:8130" />
    <!-- ARCA Ripar: os CDs copiados ficam na entrada (fora do acervo) ate o "Aplicar as faixas". -->
    <add key="PastaDeEntrada" value="D:\ARCA\Entrada" />
    <add key="Acervo" value="D:\M&#250;sicas" />
  </appSettings>
</configuration>