<Window x:Class="ARCA.Identificar.JanelaEscolhaFonte"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ARCA.Identificar"
        Title="Identificar álbum — escolher a fonte"
        Width="1000" Height="700" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Canvas}">
    <!-- Apple Music e Discogs lado a lado. Cada coluna é um PainelFonte
         (PainelFonte.xaml): o desenho da coluna se ajusta lá, uma vez para as duas.
         Nada é gravado aqui: a janela só devolve o candidato escolhido. -->
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource CabecalhoColuna}"
                BorderBrush="{StaticResource Borda}" BorderThickness="0,0,0,1" Padding="14,10">
            <StackPanel>
                <TextBlock Text="De onde vêm os metadados deste disco?" FontSize="15" Foreground="{StaticResource Acento}" />
                <TextBlock x:Name="m_lblDisco" Style="{StaticResource Fraco}" Margin="0,3,0,0"
                           Text="Faixas selecionadas: N · 0:00   ·   buscado: …" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource BarraFerramentas}"
                BorderBrush="{StaticResource Borda}" BorderThickness="0,1,0,0" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Fraco}" VerticalAlignment="Center"
                           Text="Nada muda nos arquivos até a escolha. Se nenhum dos dois for o disco certo, cancele e cole o link exato." />
                <Button Grid.Column="1" Content="Cancelar" IsCancel="True" Padding="18,6" Margin="12,0,0,0" Click="AoCancelar" />
            </Grid>
        </Border>

        <!-- Uma coluna por fonte (MusicBrainz e GnuDB pelo índice do CD; Apple Music e Discogs
             pela busca). As duas abaixo são só para o designer: o código as troca pelas fontes que vieram. -->
        <UniformGrid x:Name="m_gradePaineis" Rows="1" Margin="6,12">
            <local:PainelFonte Margin="6,0" />
            <local:PainelFonte Margin="6,0" />
        </UniformGrid>
    </DockPanel>
</Window>
