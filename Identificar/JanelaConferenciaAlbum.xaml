<Window x:Class="ARCA.Identificar.JanelaConferenciaAlbum"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conferir álbum — bit-perfect (AccurateRip)"
        Width="820" Height="640" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Canvas}">
    <!-- Conferência no AccurateRip de um álbum que já está no acervo, sem o disco:
         pelo índice do CD que o WMP gravou nas faixas (WM/MCDI). Comportamento no
         JanelaConferenciaAlbum.xaml.cs; a conta em ConferenciaAccurateRip.cs. -->
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource CabecalhoColuna}"
                BorderBrush="{StaticResource Borda}" BorderThickness="0,0,0,1" Padding="14,10">
            <StackPanel>
                <TextBlock Text="Conferir o álbum no AccurateRip" FontSize="17" Foreground="{StaticResource Acento}" />
                <TextBlock x:Name="m_lblAlbum" Style="{StaticResource Fraco}" Margin="0,3,0,0"
                           Text="Cada faixa é comparada com a assinatura de quem ripou o mesmo CD: é a prova de que a leitura foi bit-perfect." />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource BarraFerramentas}"
                BorderBrush="{StaticResource Borda}" BorderThickness="0,1,0,0" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="m_lblEstado" Style="{StaticResource Fraco}" VerticalAlignment="Center" Text="(andamento)" />
                <Button x:Name="m_btnGravar" Grid.Column="1" Content="Gravar o veredito nas faixas" Padding="14,6" Margin="12,0,0,0" IsEnabled="False" Click="AoGravar"
                        ToolTip="Grava o veredito de cada faixa no atributo ARCA/Verification do WMA. O áudio não é tocado." />
                <Button x:Name="m_btnFechar" Grid.Column="2" Content="Fechar" IsCancel="True" Padding="18,6" Margin="8,0,0,0" Click="AoFechar" />
            </Grid>
        </Border>

        <DockPanel Margin="14">
            <TextBlock x:Name="m_lblVeredito" DockPanel.Dock="Top" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,12"
                       Foreground="{StaticResource Texto}" Text="Conferindo…" />
            <DataGrid x:Name="m_grade" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserReorderColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Disco" Width="46" Binding="{Binding strDisco}" />
                    <DataGridTextColumn Header="Nº" Width="34" Binding="{Binding strNumero}" />
                    <DataGridTextColumn Header="Arquivo" Width="1.4*" Binding="{Binding strArquivo}" />
                    <DataGridTextColumn Header="Situação" Width="1*" Binding="{Binding strSituacao}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{Binding objCor}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </DockPanel>
</Window>
