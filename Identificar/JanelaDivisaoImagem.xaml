<Window x:Class="ARCA.Identificar.JanelaDivisaoImagem"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dividir imagem"
        Width="900" Height="760" MinWidth="600" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Canvas}">
    <!-- Divide uma imagem em duas por uma linha vertical (duas páginas do
         encarte digitalizadas juntas). A posição da linha é calculada pelo
         JanelaDivisaoImagem.xaml.cs; cor e espessura se ajustam aqui. -->
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource BarraFerramentas}"
                BorderBrush="{StaticResource Borda}" BorderThickness="0,0,0,1" Padding="14,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="Voltar ao meio" Padding="10,3" Margin="0,0,14,0" Click="AoVoltarAoMeio" />
                <TextBlock x:Name="m_lblTamanho" Style="{StaticResource Fraco}" VerticalAlignment="Center"
                           Text="Esquerda: 0 x 0 px    Direita: 0 x 0 px" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource BarraFerramentas}"
                BorderBrush="{StaticResource Borda}" BorderThickness="0,1,0,0" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Fraco}" VerticalAlignment="Center"
                           Text="Clique ou arraste para pôr a linha na dobra. As setas movem 1 px; com Shift, 10 px." />
                <Button Grid.Column="1" Content="Cancelar" IsCancel="True" Padding="18,6" Margin="12,0,0,0" Click="AoCancelar" />
                <Button Grid.Column="2" Content="Dividir em duas" IsDefault="True" Padding="18,6" Margin="8,0,0,0" Click="AoDividir" />
            </Grid>
        </Border>

        <Border Background="{StaticResource ChapaFunda}" BorderBrush="{StaticResource Borda}"
                BorderThickness="1" Margin="14" SizeChanged="AoRedimensionarPalco">
            <Canvas x:Name="m_palco" Background="Transparent" ClipToBounds="True" Cursor="SizeWE"
                    MouseLeftButtonDown="AoApertar" MouseMove="AoMover" MouseLeftButtonUp="AoSoltar" LostMouseCapture="AoPerderMouse">
                <Image x:Name="m_imgVista" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
                <Line x:Name="m_linha" Stroke="{StaticResource AcentoVivo}" StrokeThickness="2" IsHitTestVisible="False" />
            </Canvas>
        </Border>
    </DockPanel>
</Window>
