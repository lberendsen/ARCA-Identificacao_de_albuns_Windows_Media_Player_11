<Window x:Class="ARCA.Identificar.JanelaSepararDesconhecido"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ARCA — Separar o Álbum Desconhecido"
        Width="1360" Height="840" MinWidth="1040" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Canvas}">
    <!-- Separar o Álbum Desconhecido: faixas soltas, sem álbum, procuradas uma
         a uma no Apple Music pelo título e pela duração, e agrupadas nos discos
         de onde vieram. Comportamento no JanelaSepararDesconhecido.xaml.cs. -->
    <DockPanel>

        <Border DockPanel.Dock="Top" Background="{StaticResource CabecalhoColuna}"
                BorderBrush="{StaticResource Borda}" BorderThickness="0,0,0,1" Padding="14,10">
            <StackPanel>
                <TextBlock Text="Separar o Álbum Desconhecido" FontSize="17" Foreground="{StaticResource Acento}" />
                <TextBlock x:Name="m_lblResumoEntrada" Style="{StaticResource Fraco}" Margin="0,3,0,0"
                           Text="N faixas sem álbum. Cada uma é procurada pelo título (tirado da tag ou do nome do arquivo) e conferida pela duração." />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource BarraFerramentas}"
                BorderBrush="{StaticResource Borda}" BorderThickness="0,1,0,0" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="m_lblStatus" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{StaticResource Texto}" Text="(mensagens de status)" />
                <Button x:Name="m_btnAplicar" Grid.Column="1" Content="Aplicar" Padding="18,6" Margin="12,0,0,0" IsEnabled="False" Click="AoAplicar" />
                <Button x:Name="m_btnFechar" Grid.Column="2" Content="Fechar" IsCancel="True" Padding="18,6" Margin="8,0,0,0" Click="AoFechar" />
            </Grid>
        </Border>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="310" />
            </Grid.ColumnDefinitions>

            <!-- Esquerda: filtro, grade e registro -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="110" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="Mostrar" Style="{StaticResource Fraco}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="m_cmbFiltro" Width="420" HorizontalAlignment="Left" SelectionChanged="AoFiltrar" />
                    <TextBlock Style="{StaticResource Fraco}" VerticalAlignment="Center" Margin="12,0,0,0"
                               Text="Título e artista da busca se editam (dois cliques); o disco também." />
                </DockPanel>

                <DataGrid x:Name="m_grade" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                          CanUserDeleteRows="False" CanUserReorderColumns="False" SelectionMode="Extended"
                          HeadersVisibility="Column" GridLinesVisibility="None">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="✓" Width="30"
                                                Binding="{Binding blnAplicar, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <DataGridTextColumn Header="Arquivo" Width="1.1*" Binding="{Binding strArquivo}" IsReadOnly="True" />
                        <DataGridTextColumn Header="Dur." Width="46" Binding="{Binding strDuracao}" IsReadOnly="True" />
                        <DataGridTextColumn Header="Indício" Width="0.7*" Binding="{Binding strIndicio}" IsReadOnly="True" />
                        <DataGridTextColumn Header="Busca: título" Width="0.9*" EditingElementStyle="{StaticResource EdicaoCelula}"
                                            Binding="{Binding strTituloBusca, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <DataGridTextColumn Header="Busca: artista" Width="0.6*" EditingElementStyle="{StaticResource EdicaoCelula}"
                                            Binding="{Binding strArtistaBusca, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <DataGridTemplateColumn Header="→ Disco" Width="1.3*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding strDisco}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding lstOpcoes}"
                                              SelectedItem="{Binding objEscolhida, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="→ Nº" Width="38" Binding="{Binding strNumero}" IsReadOnly="True" />
                        <DataGridTextColumn Header="→ Título" Width="1*" Binding="{Binding strTituloNovo}" IsReadOnly="True" />
                        <DataGridTextColumn Header="Dif." Width="48" Binding="{Binding strDif}" IsReadOnly="True" />
                        <DataGridTextColumn Header="Confiança" Width="66" Binding="{Binding strConfianca}" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{Binding objCorConfianca}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Resultado" Width="0.7*" Binding="{Binding strResultado}" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBox x:Name="m_txtLog" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" />
            </Grid>

            <!-- Direita: busca, discos propostos, opções -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Busca" Style="{StaticResource Rotulo}" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="m_btnBuscar" Content="Procurar no Apple Music" Padding="12,5" Click="AoBuscar" />
                        <Button x:Name="m_btnParar" Content="Parar" Padding="12,5" Margin="6,0,0,0" IsEnabled="False" Click="AoParar" />
                    </StackPanel>
                    <Button x:Name="m_btnBuscarDeNovo" Content="Procurar de novo as selecionadas" Padding="12,4" Margin="0,6,0,0"
                            HorizontalAlignment="Left" Click="AoBuscarDeNovo"
                            ToolTip="Depois de corrigir o título ou o artista da busca na grade." />
                    <TextBlock Style="{StaticResource Fraco}" Margin="0,6,0,0"
                               Text="Na primeira vez leva uns 3 s por faixa (o Apple Music limita os pedidos). O notebook guarda cada busca: parar e retomar não repete nada." />

                    <TextBlock Text="Discos propostos" Style="{StaticResource Rotulo}" Margin="0,18,0,6" />
                    <TextBlock x:Name="m_lblDiscos" Style="{StaticResource Fraco}" Text="(depois da busca)" />

                    <TextBlock Text="Ao aplicar" Style="{StaticResource Rotulo}" Margin="0,18,0,6" />
                    <CheckBox x:Name="m_chkSoAlta" Content="Marcar só as de confiança alta" IsChecked="True" Margin="0,0,0,6" Click="AoMarcarSoAlta" />
                    <CheckBox x:Name="m_chkCapas" Content="Gravar a capa de cada disco" IsChecked="True" Margin="0,0,0,6" />
                    <CheckBox x:Name="m_chkMover" Content="Mover cada disco para a sua pasta" IsChecked="True" />
                    <TextBlock x:Name="m_lblExemploPasta" Style="{StaticResource Fraco}" Margin="20,2,0,0"
                               Text="MP3\Artista\Ano - Álbum\NN Título.mp3" />

                    <TextBlock Text="Faixas que a busca não resolve" Style="{StaticResource Rotulo}" Margin="0,18,0,6" />
                    <TextBlock Style="{StaticResource Fraco}"
                               Text="Clássico com nome genérico, séries como &quot;Beethoven Violin Sonatas (CD3) - 05&quot;: escolha o indício em &quot;Mostrar&quot; e identifique as faixas mostradas como um álbum só, pela janela de sempre (Discogs, Apple, ou à mão)." />
                    <Button x:Name="m_btnComoAlbum" Content="Identificar as mostradas como um álbum…" Padding="12,4" Margin="0,8,0,0"
                            HorizontalAlignment="Left" Click="AoIdentificarComoAlbum" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
